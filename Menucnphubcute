                            motor.Part1 = p
                            motor.C0 = handle.CFrame:ToObjectSpace(p.CFrame)
                            motor.C1 = CFrame.new()
                            motor.Parent = handle

                            local side = p.Position.X - handle.Position.X
                            table.insert(feathers, { Motor = motor, Side = side >= 0 and 1 or -1 })
                        else
                            local weld = Instance.new("WeldConstraint")
                            weld.Part0 = handle
                            weld.Part1 = p
                            weld.Parent = handle
                        end
                    end

                    rawAsset:Destroy()

                    for _, feather in ipairs(feathers) do
                        local part = feather.Motor.Part1
                        if part then
                            local attachment = Instance.new("Attachment")
                            attachment.Name = "WingFireAttachment"
                            attachment.Parent = part

                            local emitter = Instance.new("ParticleEmitter")
                            emitter.Name = "GoldenWingFire"
                            emitter.Texture = "rbxasset://textures/particles/fire_main.dds"
                            emitter.Color = ColorSequence.new({
                                Color3.fromRGB(255, 255, 80),
                                Color3.fromRGB(255, 190, 20),
                                Color3.fromRGB(255, 110, 0)
                            })
                            emitter.LightEmission = 1
                            emitter.Rate = 35
                            emitter.Lifetime = NumberRange.new(0.5, 0.9)
                            emitter.Speed = NumberRange.new(1, 3)
                            emitter.SpreadAngle = Vector2.new(30, 30)
                            emitter.Size = NumberSequence.new({
                                NumberSequenceKeypoint.new(0, 0.8),
                                NumberSequenceKeypoint.new(1, 0)
                            })
                            emitter.Parent = attachment
                        end
                    end

                    local isFlying = false
                    local flyConnection
                    local activeTrail
                    local oldHipHeight
                    local oldWalkSpeed

                    local function stopFlying()
                        if not isFlying then return end
                        isFlying = false
                        if flyConnection then flyConnection:Disconnect(); flyConnection = nil end

                        local character = LocalPlayer.Character
                        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                        local hrp = character and character:FindFirstChild("HumanoidRootPart")

                        if humanoid then
                            humanoid.Sit = false
                            humanoid.PlatformStand = false
                            if oldHipHeight then humanoid.HipHeight = oldHipHeight end
                            if oldWalkSpeed then humanoid.WalkSpeed = oldWalkSpeed end
                        end
                        if hrp then hrp.Anchored = false end

                        for _, feather in ipairs(feathers) do
                            feather.Motor.Transform = CFrame.new()
                        end
                        if activeTrail then activeTrail:Destroy(); activeTrail = nil end
                    end

                    local function startFlying()
                        if isFlying then return end
                        local character = LocalPlayer.Character
                        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                        local hrp = character and character:FindFirstChild("HumanoidRootPart")
                        if not (character and humanoid and hrp) then return end

                        local handlePart = tool:FindFirstChild("Handle")
                        if not handlePart then return end

                        isFlying = true
                        oldHipHeight = humanoid.HipHeight
                        oldWalkSpeed = humanoid.WalkSpeed

                        humanoid.Sit = true
                        humanoid.HipHeight = 2.5

                        local fireAttachment = Instance.new("Attachment")
                        fireAttachment.Name = "GoldenFireTrail"
                        fireAttachment.Position = Vector3.new(0, 0, 2.5)
                        fireAttachment.Parent = handlePart

                        local fire = Instance.new("ParticleEmitter")
                        fire.Name = "GoldenFire"
                        fire.Texture = "rbxasset://textures/particles/fire_main.dds"
                        fire.Color = ColorSequence.new({
                            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 80)),
                            ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 190, 20)),
                            ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 90, 0))
                        })
                        fire.LightEmission = 1
                        fire.Rate = 130
                        fire.Lifetime = NumberRange.new(1.5, 2.2)
                        fire.Speed = NumberRange.new(3, 6)
                        fire.SpreadAngle = Vector2.new(12, 12)
                        fire.Drag = 2
                        fire.Size = NumberSequence.new({
                            NumberSequenceKeypoint.new(0, 1.2),
                            NumberSequenceKeypoint.new(0.4, 0.9),
                            NumberSequenceKeypoint.new(1, 0)
                        })
                        fire.Transparency = NumberSequence.new({
                            NumberSequenceKeypoint.new(0, 0.05),
                            NumberSequenceKeypoint.new(0.7, 0.2),
                            NumberSequenceKeypoint.new(1, 1)
                        })
                        fire.Parent = fireAttachment
                        activeTrail = fireAttachment

                        local speed = 55
                        local currentPos = hrp.Position
                        local flapTime = 0

                        flyConnection = RunService.RenderStepped:Connect(function(dt)
                            if not isFlying or humanoid.Health <= 0 or tool.Parent ~= character then
                                stopFlying()
                                return
                            end
                            local camera = Workspace.CurrentCamera
                            if not camera then return end

                            hrp.Anchored = true
                            local moveDir = humanoid.MoveDirection
                            local cam = camera.CFrame
                            local flatLook = Vector3.new(cam.LookVector.X, 0, cam.LookVector.Z)
                            local flatRight = Vector3.new(cam.RightVector.X, 0, cam.RightVector.Z)

                            if flatLook.Magnitude > 0 then flatLook = flatLook.Unit end
                            if flatRight.Magnitude > 0 then flatRight = flatRight.Unit end

                            local forward = moveDir:Dot(flatLook)
                            local right = moveDir:Dot(flatRight)
                            local direction = flatRight * right + cam.LookVector * forward

                            if direction.Magnitude > 0.05 then
                                direction = direction.Unit
                                currentPos += direction * speed * dt
                                hrp.CFrame = CFrame.lookAt(currentPos, currentPos + direction)
                            else
                                hrp.CFrame = CFrame.lookAt(currentPos, currentPos + cam.LookVector)
                            end

                            handlePart.CFrame = hrp.CFrame * CFrame.new(0, -2.6, -0.2)

                            flapTime += dt * 2.2
                            local angle = math.sin(flapTime) * math.rad(15)
                            for _, feather in ipairs(feathers) do
                                feather.Motor.Transform = CFrame.Angles(0, 0, angle * feather.Side)
                            end
                        end)
                    end

                    tool.Activated:Connect(function()
                        if isFlying then stopFlying() else startFlying() end
                    end)
                    tool.Unequipped:Connect(stopFlying)
                    tool.Parent = backpack
                end)
            end)
        end
    }
}

